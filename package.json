{
  "name": "property-management",
  "version": "1.0.0",
  "description": "Property Management System Backend",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "clean": "rm -rf dist",
    "create-dist": "mkdir -p dist",
    "prebuild": "npm run clean && npm run create-dist",
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "node scripts/copy-migrations.js",
    "lint": "eslint . --ext .ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:generate",
    "migration:run": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:revert": "npx typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "property",
    "management",
    "typescript",
    "node",
    "express",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/validator": "^13.12.2",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.9.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.22",
    "typeorm-extension": "^3.7.0",
    "typescript": "^5.3.3",
    "validator": "^13.12.0",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1"
  }
}
